{
  "expo": {
    "name": "Pine Ridge Campground",
    "slug": "campground-reservation",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/campground-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17351F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#17351F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/campground-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#17351F"
        }
      ]
    ]
  }
}